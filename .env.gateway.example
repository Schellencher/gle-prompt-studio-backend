# Existing OpenAI setup
OPENAI_API_KEY_SERVER=
OPENAI_API_BASE=https://api.openai.com/v1
MODEL_BYOK=gpt-4o-mini
MODEL_PRO=gpt-4o
MODEL_BOOST=gpt-4o

# New DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high

# GLE model aliases (provider and model can be changed without frontend changes)
GLE_FAST_PROVIDER=deepseek
GLE_FAST_MODEL=deepseek-v4-flash
GLE_BALANCED_PROVIDER=openai
GLE_BALANCED_MODEL=gpt-4o
GLE_PRECISION_PROVIDER=openai
GLE_PRECISION_MODEL=gpt-4o
GLE_JUDGE_PROVIDER=deepseek
GLE_JUDGE_MODEL=deepseek-v4-pro

# Which alias the existing Studio route uses
GLE_PRO_ALIAS=gle-balanced
GLE_BOOST_ALIAS=gle-precision
GLE_TRIAL_ALIAS=gle-balanced

# Reliability
GLE_PROVIDER_TIMEOUT_MS=90000

# Optional token prices in EUR per 1M tokens.
# Keep blank/0 until verified; token usage is always logged.
# Example variable format:
# DEEPSEEK_DEEPSEEK_V4_FLASH_INPUT_EUR_PER_M=0
# DEEPSEEK_DEEPSEEK_V4_FLASH_CACHED_INPUT_EUR_PER_M=0
# DEEPSEEK_DEEPSEEK_V4_FLASH_OUTPUT_EUR_PER_M=0
